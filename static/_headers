# Response headers for every page. Read by Netlify and by Cloudflare Workers static
# assets alike (same syntax), so they live here rather than in netlify.toml.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Browser caching. Both hosts default to max-age=0, must-revalidate, so without these
# every page view re-asked the server for each font, stylesheet and image before
# using it (the fonts visibly swapped in on every page). Pages themselves keep the
# default, so a deploy shows up at once.

# The CSS and JS bundles are fingerprinted (layouts/partials/base/styles.html,
# scripts.html): a change gets a new URL.
/styles/*
  Cache-Control: public, max-age=31536000, immutable
/scripts/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are not fingerprinted: give a changed font file a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Uploads. Resized copies (…_hu_<hash>.webp) get a new name when the original
# changes, but an original re-uploaded under the same name keeps its URL, so a day.
/media/*
  Cache-Control: public, max-age=86400
